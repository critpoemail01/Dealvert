@{
    var currentPath = Context.Request.Path.Value ?? string.Empty;
    var isActive = (string pagePath) => currentPath.Equals(pagePath, StringComparison.OrdinalIgnoreCase);
    var isActivePrefix = (string pagePath) => currentPath.StartsWith(pagePath, StringComparison.OrdinalIgnoreCase);
    var isPriceAlertArea = isActivePrefix("/App/Alerts");
    var workspaceTitle = ViewData["Title"]?.ToString() ?? "Workspace";
    var userName = User?.Identity?.Name ?? "account";
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dealvert</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="icon" type="image/svg+xml" href="~/assets/brand/dealvert_favicon.svg" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/assets/brand/dealvert_favicon_32.png" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="512x512" href="~/assets/brand/dealvert_icon_512_clean.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/vert-template.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="vert-app-page">
<div class="app-shell">
    <aside class="app-sidebar">
        <a class="app-brand app-sidebar-brand brand-lockup" asp-page="/Index" aria-label="Dealvert home">
            <span class="brand-mark">
                <img src="~/assets/brand/dealvert_brand_mark.svg" width="44" height="44" asp-append-version="true" alt="" />
            </span>
            <span class="brand-wordmark">
                <span class="brand-title">Dealvert<sup>TM</sup></span>
                <span class="brand-subtitle">Price Radar AI</span>
            </span>
        </a>

        <a class="app-sidebar-cta" asp-page="/App/Alerts/Create">
            <span class="app-sidebar-cta-icon"><i class="bi bi-stars"></i></span>
            <span>
                <strong>Start watching</strong>
                <small>Create price alerts or reports</small>
            </span>
        </a>

        <nav class="app-nav" aria-label="App navigation">
            <div class="app-nav-section">Workspace</div>
            <a class="app-nav-link @(isActive("/App/Dashboard") ? "active" : "")" asp-page="/App/Dashboard">
                <span class="app-nav-icon"><i class="bi bi-grid-fill"></i></span>
                <span>Overview</span>
            </a>
            <a class="app-nav-link @(isPriceAlertArea ? "active" : "")" asp-page="/App/Alerts/Index">
                <span class="app-nav-icon"><i class="bi bi-bag-check-fill"></i></span>
                <span>Price alerts</span>
            </a>
            <a class="app-nav-link @(isActive("/App/Log") ? "active" : "")" asp-page="/App/Log">
                <span class="app-nav-icon"><i class="bi bi-clock-history"></i></span>
                <span>History</span>
            </a>
            <a class="app-nav-link @(isActivePrefix("/App/Planner") ? "active" : "")" asp-page="/App/Planner/Index">
                <span class="app-nav-icon"><i class="bi bi-briefcase-fill"></i></span>
                <span>Reports</span>
            </a>

            <div class="app-nav-section">Account and settings</div>
            <a class="app-nav-link @(isActivePrefix("/App/Account") ? "active" : "")" asp-page="/App/Account/Index">
                <span class="app-nav-icon"><i class="bi bi-person-fill"></i></span>
                <span>Personal details</span>
            </a>
            <a class="app-nav-link @(isActive("/App/Billing") ? "active" : "")" asp-page="/App/Billing">
                <span class="app-nav-icon"><i class="bi bi-credit-card-2-front-fill"></i></span>
                <span>Subscription</span>
            </a>
            <a class="app-nav-link @(isActive("/App/Settings") ? "active" : "")" asp-page="/App/Settings">
                <span class="app-nav-icon"><i class="bi bi-broadcast-pin"></i></span>
                <span>Notifications</span>
            </a>
            <a class="app-nav-link @(isActive("/App/HelpDesk") ? "active" : "")" asp-page="/App/HelpDesk">
                <span class="app-nav-icon"><i class="bi bi-chat-left-text-fill"></i></span>
                <span>Help</span>
            </a>
        </nav>

        <div class="app-sidebar-footer">
            <a class="app-sidebar-user" asp-page="/App/Account/Index" title="@userName">
                <i class="bi bi-person-circle"></i>
                <span>@userName</span>
            </a>
        </div>
    </aside>

    <div class="app-main">
        <header class="app-topbar">
            <div class="app-workspace-context">
                <span><i class="bi bi-command"></i> Workspace</span>
                <strong>@workspaceTitle</strong>
            </div>

            <div class="app-topbar-actions">
                @await Component.InvokeAsync("AppPlanBadge")
                @await Component.InvokeAsync("AppPlanCta")
                <a class="btn btn-sm btn-outline-secondary app-topbar-button app-site-return" asp-page="/Index">
                    <i class="bi bi-arrow-left me-1"></i>Back to site
                </a>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index")" method="post">
                    <button type="submit" class="btn btn-sm btn-outline-secondary app-topbar-button">
                        <i class="bi bi-box-arrow-right me-1"></i>Sign out
                    </button>
                </form>
            </div>
        </header>

        <main class="app-content">
            @RenderBody()
        </main>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
